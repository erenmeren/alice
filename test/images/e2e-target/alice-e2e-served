#!/bin/sh
# Test only: the SHA-256 fingerprint (64 lower-case hex digits) of the leaf certificate the local
# nginx serves for the server name NAME on port 443.
set -eu
[ "$#" -eq 1 ] || { echo "usage: alice-e2e-served NAME" >&2; exit 2; }
fp=$(openssl s_client -connect 127.0.0.1:443 -servername "$1" </dev/null 2>/dev/null |
	openssl x509 -noout -fingerprint -sha256 | cut -d= -f2 | tr -d : | tr 'A-F' 'a-f')
printf '%s' "$fp" | grep -Eqx '[0-9a-f]{64}' || { echo "alice-e2e-served: no certificate served for $1" >&2; exit 1; }
echo "$fp"
