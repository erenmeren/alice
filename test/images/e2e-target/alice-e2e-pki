#!/bin/sh
# Test only: the throwaway test CA of the e2e SSH target and the certificates it signs. Nothing
# here is committed or baked into an image layer: the CA is created when the container starts,
# and its key never leaves the container.
#   alice-e2e-pki init        create the CA (if missing) and the website pairs (if missing)
#   alice-e2e-pki www         a fresh www.example.test pair
#   alice-e2e-pki sites       a fresh pair for each of s1..s5.example.test
#   alice-e2e-pki apache      fresh certificates for the Apache websites (apache-sites.conf):
#                             apache.example.test as apache.crt and apache.key, combined.example.test
#                             as combined.pem (certificate, CA and key in one file), in /etc/apache2/ssl
#   alice-e2e-pki leaf NAMES DIR   write DIR/leaf.pem (leaf + CA) and DIR/leaf.key for NAMES (one
#                                  name, or several separated by commas: the first is the CN)
#   alice-e2e-pki sign NAMES  read a signing request on stdin and print a certificate for NAMES
#                             signed by the test CA, then the CA certificate (the request's own
#                             names are ignored, so a test can make them differ)
set -eu
ca=/opt/alice-test-ca
umask 077

valid_name() {
	printf '%s' "$1" | grep -Eqx '[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?' || {
		echo "alice-e2e-pki: invalid name: $1" >&2
		exit 2
	}
}

ensure_ca() {
	[ -f "$ca/ca.key" ] && [ -f "$ca/ca.pem" ] && return 0
	install -d -m 0700 -o root -g root "$ca"
	openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -sha256 -days 3650 \
		-subj "/CN=Alice e2e test CA $(openssl rand -hex 4)" \
		-addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign \
		-keyout "$ca/ca.key" -out "$ca/ca.pem" 2>/dev/null
	chmod 0600 "$ca/ca.key"
	chmod 0644 "$ca/ca.pem"
}

# ext NAMES FILE: the leaf extensions for NAMES (comma-separated) in FILE; prints the first name.
ext() {
	san=
	first=
	for n in $(printf '%s' "$1" | tr ',' ' '); do
		valid_name "$n"
		[ -n "$first" ] || first=$n
		san="${san:+$san,}DNS:$n"
	done
	[ -n "$first" ] || { echo "alice-e2e-pki: no name" >&2; exit 2; }
	cat >"$2" <<EXT
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=serverAuth
subjectAltName=$san
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid
EXT
	echo "$first"
}

# leaf NAMES DIR: a fresh P-256 key and a 90-day leaf for NAMES signed by the test CA.
leaf() {
	ensure_ca
	cn=$(ext "$1" "$2/ext")
	openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -subj "/CN=$cn" \
		-keyout "$2/leaf.key" -out "$2/leaf.csr" 2>/dev/null
	openssl x509 -req -in "$2/leaf.csr" -CA "$ca/ca.pem" -CAkey "$ca/ca.key" \
		-set_serial "0x$(openssl rand -hex 16)" -days 90 -sha256 -extfile "$2/ext" -out "$2/leaf.crt" 2>/dev/null
	cat "$2/leaf.crt" "$ca/ca.pem" >"$2/leaf.pem"
}

# sign NAMES: sign the request on stdin for NAMES; print the certificate and the CA certificate.
sign() {
	ensure_ca
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	ext "$1" "$tmp/ext" >/dev/null
	head -c 65536 >"$tmp/req.csr"
	openssl req -in "$tmp/req.csr" -noout -verify 2>/dev/null || { echo "alice-e2e-pki: not a valid signing request" >&2; exit 1; }
	openssl x509 -req -in "$tmp/req.csr" -CA "$ca/ca.pem" -CAkey "$ca/ca.key" \
		-set_serial "0x$(openssl rand -hex 16)" -days 90 -sha256 -extfile "$tmp/ext" -out "$tmp/leaf.crt" 2>/dev/null
	cat "$tmp/leaf.crt" "$ca/ca.pem"
}

# pair NAME FILE: install a fresh pair for NAME as nginx's FILE.crt and FILE.key (root-owned; key 0600).
pair() {
	tmp=$(mktemp -d)
	leaf "$1" "$tmp"
	install -d -m 0755 -o root -g root /etc/nginx/ssl
	install -m 0644 -o root -g root "$tmp/leaf.pem" "/etc/nginx/ssl/$2.crt"
	install -m 0600 -o root -g root "$tmp/leaf.key" "/etc/nginx/ssl/$2.key"
	rm -rf "$tmp"
}

www() { pair www.example.test www; }

# sites: the five extra websites s1..s5.example.test (a batch deployment needs several).
sites() {
	for i in 1 2 3 4 5; do pair "s$i.example.test" "s$i"; done
}

# apache: the two Apache websites' files (root-owned; keys and the combined file 0600).
apache() {
	install -d -m 0755 -o root -g root /etc/apache2/ssl
	tmp=$(mktemp -d)
	leaf apache.example.test "$tmp"
	install -m 0644 -o root -g root "$tmp/leaf.pem" /etc/apache2/ssl/apache.crt
	install -m 0600 -o root -g root "$tmp/leaf.key" /etc/apache2/ssl/apache.key
	rm -rf "$tmp"
	tmp=$(mktemp -d)
	leaf combined.example.test "$tmp"
	cat "$tmp/leaf.pem" "$tmp/leaf.key" >"$tmp/combined.pem"
	install -m 0600 -o root -g root "$tmp/combined.pem" /etc/apache2/ssl/combined.pem
	rm -rf "$tmp"
}

case "${1:-}" in
init)
	ensure_ca
	[ -f /etc/nginx/ssl/www.crt ] && [ -f /etc/nginx/ssl/www.key ] || www
	[ -f /etc/nginx/ssl/s5.crt ] && [ -f /etc/nginx/ssl/s5.key ] || sites
	;;
www) www ;;
sites) sites ;;
apache) apache ;;
leaf)
	[ "$#" -eq 3 ] || { echo "usage: alice-e2e-pki leaf NAMES DIR" >&2; exit 2; }
	leaf "$2" "$3"
	;;
sign)
	[ "$#" -eq 2 ] || { echo "usage: alice-e2e-pki sign NAMES < request.csr" >&2; exit 2; }
	sign "$2"
	;;
*)
	echo "usage: alice-e2e-pki init | www | sites | apache | leaf NAMES DIR | sign NAMES" >&2
	exit 2
	;;
esac
