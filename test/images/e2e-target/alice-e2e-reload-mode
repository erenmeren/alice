#!/bin/sh
# Test only: how the next "systemctl reload nginx" behaves (see /usr/bin/systemctl, the shim):
# ok | fail-once | fail | noop | drop-once (drop-once ends Alice's SSH session before the reload).
# fail-once and drop-once are consumed by the next reload, whichever subcommand runs it (a
# deployment's reload or its rollback's). POST /test/reset does not reset this: use
# alice-e2e-nginx-reset.
set -eu
case "${1:-}" in
ok | fail-once | fail | noop | drop-once) echo "$1" >/etc/alice-e2e/reload-mode ;;
*)
	echo "usage: alice-e2e-reload-mode ok|fail-once|fail|noop|drop-once" >&2
	exit 2
	;;
esac
