#!/bin/sh
# TEST ONLY (the e2e SSH target image and the real-Nginx container matrix, test/images/sshd; never
# part of a release or of a real server).
# The container runs no systemd, so this stands in for /usr/bin/systemctl, the fixed path
# alice-helper runs. It handles exactly the two calls the helper makes and refuses anything else:
#   systemctl reload nginx              -> /usr/sbin/nginx -s reload (what nginx.service's
#                                          ExecReload does on Ubuntu 22.04)
#   systemctl is-active --quiet nginx   -> exit 0 while an nginx process runs
# Differences from systemd: is-active looks for a process, not the unit's state; reload is not
# serialised with other unit jobs. /etc/alice-e2e/reload-mode (alice-e2e-reload-mode) injects
# faults for the deployment failure journeys: ok (default), fail-once (the next reload exits 1,
# then ok), fail (every reload exits 1), noop (exit 0 without reloading: nginx keeps serving the
# old certificate), and block-once (the container matrix only: the next reload writes "reload" to
# /etc/alice-e2e/blocked and waits for one line on the FIFO /etc/alice-e2e/release; "go" reloads,
# anything else exits 1 without reloading).
mode=$(cat /etc/alice-e2e/reload-mode 2>/dev/null || echo ok)
case "$*" in
"reload nginx")
	case "$mode" in
	fail-once)
		echo ok >/etc/alice-e2e/reload-mode
		echo "Job for nginx.service failed (alice-e2e fault injection)." >&2
		exit 1
		;;
	fail)
		echo "Job for nginx.service failed (alice-e2e fault injection)." >&2
		exit 1
		;;
	noop) exit 0 ;;
	block-once)
		echo ok >/etc/alice-e2e/reload-mode
		echo reload >/etc/alice-e2e/blocked
		read -r release </etc/alice-e2e/release || release=
		rm -f /etc/alice-e2e/blocked
		[ "$release" = go ] || exit 1
		;;
	esac
	exec /usr/sbin/nginx -s reload
	;;
"is-active --quiet nginx")
	exec pgrep -x nginx >/dev/null
	;;
*)
	echo "systemctl (alice-e2e test shim): unsupported: $*" >&2
	exit 1
	;;
esac
