# Test-only directory tree of the e2e fake directory (compose service fakeldap of deploy/docker-compose.e2e.yml).
# The same tree, names and throw-away passwords as internal/testutil/fakeldap (the integration tests' OpenLDAP):
# ada (in alice-ops), çiğdem (in alice-auditors, which is nested in alice-ops), grace (in no group), the login "dup"
# shared by two entries, the read-only service account and a posixGroup. slapadd loads it into a tmpfs at every
# container start, so a restart brings back exactly this tree (the directory journey changes group membership).
# Non-ASCII values are base64 ("attr:: value") as LDIF requires.

dn: dc=example,dc=test
objectClass: dcObject
objectClass: organization
o: Example
dc: example

dn: ou=people,dc=example,dc=test
objectClass: organizationalUnit
ou: people

dn: ou=contractors,ou=people,dc=example,dc=test
objectClass: organizationalUnit
ou: contractors

dn: ou=groups,dc=example,dc=test
objectClass: organizationalUnit
ou: groups

dn: ou=services,dc=example,dc=test
objectClass: organizationalUnit
ou: services

dn: cn=alice-svc,ou=services,dc=example,dc=test
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: alice-svc
userPassword: svc-Pa55-0f-the-service

dn: uid=ada,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
uid: ada
cn: Ada Lovelace
sn: Lovelace
mail: ada@example.test
userPassword: ada-Analytical-1843

