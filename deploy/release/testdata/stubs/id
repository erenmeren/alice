#!/usr/bin/env bash
# Test stub: "id -u" prints STUB_UID; anything else runs the real id.
set -euo pipefail
# shellcheck source=stub-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/stub-common.sh"
stub_record id "$@"
if [[ "$*" == "-u" ]]; then
  printf '%s\n' "${STUB_UID:-0}"
else
  stub_real id "$@"
fi
